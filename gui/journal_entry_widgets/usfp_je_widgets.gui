#Manifest Destiny JE List
flowcontainer = {
	name = "usfp_widget_je_manifest_destiny_active_je_list"

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 4
		datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

		item = {
			flowcontainer = {
				visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_manifest_destiny').Self)]"
				direction = vertical
				spacing = 4

				textbox = {
					autoresize = yes
					align = nobaseline
					default_format = "#title"
					margin_bottom = 2
					text = "je_manifest_destiny_control_active_je_list_header"
				}

				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

					item = {
						journal_entry = {
							visible = "[Not(ObjectsEqual(JournalEntryType.Self, JournalEntryPanel.GetJournalEntryType.Self))]"
							datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
						}
					}
				}
			}
		}
	}
}

#A House Divided List
flowcontainer = {
    name = "usfp_widget_a_house_divided_active_je_list"

    flowcontainer = {
        direction = vertical
        parentanchor = hcenter
        spacing = 4
        datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"

        item = {
            flowcontainer = {
                visible = "[ObjectsEqual(JournalEntryGroup.Self, GetJournalEntryGroup('je_group_usa_american_civil_war').Self)]"
                direction = vertical
                spacing = 4

                textbox = {
                    autoresize = yes
                    align = nobaseline
                    default_format = "#title"
                    margin_bottom = 2
                    text = "usfp_relevant_jes_list"
                }

                flowcontainer = {
                    direction = vertical
                    spacing = 4
                    ignoreinvisible = yes
                    datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"

                    item = {
                        journal_entry = {
                            visible = "[Not(ObjectsEqual(JournalEntryType.Self, JournalEntryPanel.GetJournalEntryType.Self))]"
                            datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
                        }
                    }
                }
            }
        }
    }
}


